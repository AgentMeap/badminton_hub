# Chuẩn hóa xuống dòng: lưu LF trong repo, Git tự đổi khi checkout trên Windows
* text=auto eol=lf

# Script Windows giữ CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Script shell bắt buộc LF (gradlew lỗi "bad interpreter" nếu bị CRLF)
gradlew text eol=lf
*.sh    text eol=lf

# File nhị phân
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.xlsx binary
*.docx binary
*.pptx binary
*.apk  binary
*.aab  binary

# GitHub: không tính file sinh tự động vào thống kê ngôn ngữ
*.g.dart       linguist-generated=true
*.freezed.dart linguist-generated=true
pubspec.lock   linguist-generated=true
